# macOS system file
.DS_Store

# R history file
.Rhistory
.RData

# PDF outputs (regenerated by scripts, not tracked)
*.pdf

# driver_mutation backup snapshots
data/driver_mutation/backups/

# Fig1_Driver_mutation: ignore all subfolders except oncoplots_files (the
# knitted figure assets for the current oncoplots.Rmd)
Fig1_Driver_mutation/*/
!Fig1_Driver_mutation/oncoplots_files/
!Fig1_Driver_mutation/individual_apc_driver_lollipops_files/

# Fig2_Mutation_burden: ignore all subfolders except the knitted output folders
Fig2_Mutation_burden/*/
!Fig2_Mutation_burden/Fig2_boxplots_files/
!Fig2_Mutation_burden/Fig2_dotplots_files/
# stale knitted image no longer produced by Fig2_dotplots.Rmd
Fig2_Mutation_burden/Fig2_dotplots_files/figure-html/telomere-dotplot-1.png

# Fig3_Signature_analysis: ignore all subfolders except the knitted output folders
Fig3_Signature_analysis/*/
!Fig3_Signature_analysis/Fig3a_signatures_files/
!Fig3_Signature_analysis/Fig3bc_disease_effect_files/

# backup copies and knit logs
*.bak*
*.log
